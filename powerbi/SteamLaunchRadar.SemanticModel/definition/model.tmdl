model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["juegos","calendario","lecturas","curva_diaria","predicciones","metricas","OrigenDatos"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table juegos
ref table calendario
ref table lecturas
ref table curva_diaria
ref table predicciones
ref table metricas

