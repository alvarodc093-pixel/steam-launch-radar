		sourceColumn: dentro_rango

	partition predicciones = m
		mode: import
		source =
				let
				    Ruta = OrigenDatos & "predicciones.csv",
				    Contenido = if Text.StartsWith(Ruta, "http") then Web.Contents(Ruta) else File.Contents(Ruta),
				    Origen = Csv.Document(Contenido, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"appid", Int64.Type}, {"dia_lectura", Int64.Type}, {"resenas_lectura", Int64.Type}, {"estimacion", type number}, {"rango_inferior", type number}, {"rango_superior", type number}, {"resenas_30d_reales", Int64.Type}, {"error_log", type number}, {"dentro_rango", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
