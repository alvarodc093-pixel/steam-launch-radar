table juegos
	lineageTag: 8dda527d-4bff-5aa8-a011-5262fcc8e077

	/// Juegos descargados del buscador de Steam.
	measure 'Lanzamientos' = COUNTROWS(juegos)
		formatString: #,0
		lineageTag: a077a5aa-74b2-52c4-b965-0d8bcf9ade02

	/// Juegos que entran en el modelo tras la limpieza.
	measure 'Lanzamientos aptos' = CALCULATE(COUNTROWS(juegos), juegos[estado] = "apto")
		formatString: #,0
		lineageTag: da8d2336-053a-52f6-864e-d6d05be190db

	/// Parte de los juegos descargados que se excluye en el preprocesamiento.
	measure '% excluidos' = DIVIDE([Lanzamientos] - [Lanzamientos aptos], [Lanzamientos])
		formatString: 0.0 %
		lineageTag: a0ef914f-b319-5090-9362-793593e395e7

	/// Reseñas en inglés al cumplir 30 días del juego mediano.
	measure 'Mediana reseñas 30 días' = CALCULATE(MEDIAN(juegos[resenas_30d]), juegos[estado] = "apto")
		formatString: #,0
		lineageTag: f7e544e2-9a68-5982-84d2-f9422e3ae2ee

	/// Porcentaje de reseñas positivas en la primera semana del juego mediano.
	measure 'Mediana positivas 7 días' = CALCULATE(MEDIAN(juegos[pct_positivas_7d]), juegos[estado] = "apto")
		formatString: 0 %
		lineageTag: 94d63692-8d4b-5b6e-924e-f506dbac25e3

