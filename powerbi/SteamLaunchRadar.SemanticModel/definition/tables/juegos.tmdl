	partition juegos = m
		mode: import
		source =
				let
				    Ruta = OrigenDatos & "juegos.csv",
				    Contenido = if Text.StartsWith(Ruta, "http") then Web.Contents(Ruta) else File.Contents(Ruta),
				    Origen = Csv.Document(Contenido, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"appid", Int64.Type}, {"nombre", type text}, {"fecha_lanzamiento", type date}, {"precio_usd", type number}, {"banda_precio", type text}, {"banda_orden", Int64.Type}, {"genero_principal", type text}, {"es_indie", type text}, {"desarrollador", type text}, {"editor", type text}, {"estado", type text}, {"estado_descripcion", type text}, {"resenas_30d", Int64.Type}, {"pct_positivas_7d", type number}, {"conjunto", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
