# Ninguna fuente necesita clave. Este correo va en el User-Agent de las
# peticiones para que Steam pueda contactar si hay un problema.
CONTACTO_USER_AGENT=

# Asistente (RAG). En local basta con tener Ollama abierto y los modelos
# descargados: ollama pull embeddinggemma && ollama pull qwen3.5
# En Vercel no hay Ollama local: OLLAMA_HOST=https://ollama.com, la clave de
# ollama.com/settings/keys en OLLAMA_API_KEY y un modelo de la nube en
# OLLAMA_MODELO (por ejemplo gpt-oss:120b).
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODELO=qwen3.5
OLLAMA_EMBEDDINGS=embeddinggemma
